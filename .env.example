# Copy this file to .env and fill in your own local values.
# Never commit .env or real tokens to Git.

# Shared token for Hive API & Workers (required for network binds and execute_code)
FENRIR_HIVE_TOKEN=replace-with-your-own-random-token

# Hive bind host (default: 127.0.0.1; external bind requires FENRIR_HIVE_TOKEN)
FENRIR_HIVE_HOST=127.0.0.1

# Master Hive IP used by swarm workers (default: 127.0.0.1)
FENRIR_MASTER_IP=127.0.0.1

# Optional worker idle exit in seconds (0 = stay running)
FENRIR_WORKER_IDLE_EXIT=0

# Optional local LLM/Grok endpoint URL
FENRIR_GROK_URL=http://127.0.0.1:8080/v1/chat/completions

# Hugging Face token (only required when running hf_uploader.py with --upload)
HF_TOKEN=
